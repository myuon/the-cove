use contract.Aim
use contract.Bed
use contract.Intent
use contract.Morsel
use contract.Observation
use contract.Point
use contract.SelfView
use contract.Sighting

// The moves any creature could make, written once.
//
// Twelve species reading the same observation would otherwise each write their
// own "which way is the food" and their own tie-break, and two that broke a
// tie differently would make a run depend on which of them was asked first.
// What is left in a species module after this is what that species actually
// decides.
//
// Nothing here draws a random number. A behaviour is given no generator, so
// two creatures in the same place with the same observation answer the same
// thing -- which is what makes a species a function rather than a process.
//
// Nothing here takes a square root either, because the language has none. Every
// comparison of distances is a comparison the host already made, or a
// comparison of squares.

/// The creatures this one is hunted by.
export fn threats(sightings: Array<Sighting>) -> Array<Sighting> {
  sightings.filter(fn(sighting) {
    sighting.role.hunts()
  })
}

/// The creatures this one would eat, if it ate creatures.
export fn prey(sightings: Array<Sighting>) -> Array<Sighting> {
  sightings.filter(fn(sighting) {
    sighting.role.isPrey()
  })
}

/// The others of this creature's own kind.
export fn kin(view: SelfView, sightings: Array<Sighting>) -> Array<Sighting> {
  sightings.filter(fn(sighting) {
    sighting.species == view.species
  })
}

/// The sightings no further off than `range`.
export fn within(sightings: Array<Sighting>, range: Float) -> Array<Sighting> {
  sightings.filter(fn(sighting) {
    sighting.away <= range
  })
}

/// The nearest of these sightings, and the lowest id among those tied.
///
/// A fold rather than a sort: one answer is wanted and a sort would build a
/// whole ordering to take the front of it. The comparison is strict, so the
/// earlier element wins a tie -- and `Observation.nearby` already arrives
/// nearest first and lowest id first, which is the order this preserves rather
/// than a second ordering laid over it.
export fn nearest(sightings: Array<Sighting>) -> Option<Sighting> {
  let nothing: Option<Sighting> = None
  sightings.fold(
    initial: nothing,
    step: fn(best: Option<Sighting>, sighting: Sighting) {
      match best {
        None => Some(sighting)
        Some(found) => if sighting.away < found.away {
          Some(sighting)
        } else {
          Some(found)
        }
      }
    },
  )
}

/// The fullest mouthful in sight, and the nearest of those tied.
export fn richest(observation: Observation) -> Option<Morsel> {
  let nothing: Option<Morsel> = None
  observation.food.fold(
    initial: nothing,
    step: fn(best: Option<Morsel>, morsel: Morsel) {
      match best {
        None => Some(morsel)
        Some(found) => if morsel.amount > found.amount ||
          morsel.amount == found.amount && morsel.away < found.away {
          Some(morsel)
        } else {
          Some(found)
        }
      }
    },
  )
}

/// The nearest bed of kelp in sight.
export fn shelter(observation: Observation) -> Option<Bed> {
  let nothing: Option<Bed> = None
  observation.kelp.fold(
    initial: nothing,
    step: fn(best: Option<Bed>, bed: Bed) {
      match best {
        None => Some(bed)
        Some(found) => if bed.away < found.away {
          Some(bed)
        } else {
          Some(found)
        }
      }
    },
  )
}

/// Swim towards a place, trying this hard.
export fn toward(at: Point, effort: Float) -> Intent {
  Intent.Toward(Aim(at: at, effort: effort))
}

/// Swim away from a place, trying this hard.
export fn away(at: Point, effort: Float) -> Intent {
  Intent.Away(Aim(at: at, effort: effort))
}

/// Eight directions, each one unit long, in the order a tie is broken in.
///
/// Written out rather than computed, because computing them would need an
/// angle and the reef has no trigonometry: a direction here is a vector and
/// never a bearing. The diagonals are one over the square root of two, which
/// is a literal a machine reads exactly rather than a call whose last bit two
/// machines might disagree about.
export fn compass() -> Array<Point> {
  [
    Point(x: 1.0, y: 0.0),
    Point(x: 0.7071067811865476, y: 0.7071067811865476),
    Point(x: 0.0, y: 1.0),
    Point(x: -0.7071067811865476, y: 0.7071067811865476),
    Point(x: -1.0, y: 0.0),
    Point(x: -0.7071067811865476, y: -0.7071067811865476),
    Point(x: 0.0, y: -1.0),
    Point(x: 0.7071067811865476, y: -0.7071067811865476),
  ]
}

/// A direction chosen by nothing in particular.
///
/// "Nothing in particular" still has to be the same nothing on every run, so
/// it is the creature's own id and the tick that choose, and not a draw the
/// behaviour has no generator to make. It changes slowly -- one step of the
/// compass every sixteen ticks -- because a creature that picked a fresh
/// direction every tick would shiver rather than wander.
export fn drift(view: SelfView, observation: Observation) -> Point {
  let turns = compass()
  let picked = (view.id + observation.tick / 16) % turns.length()
  match turns.get(picked) {
    Some(direction) => direction
    None => Point(x: 1.0, y: 0.0)
  }
}

/// A place to head for when there is nothing to head for.
///
/// Far enough that the creature keeps going for a while rather than arriving
/// and stopping, and kept inside the reef so that wandering never means
/// pressing against a wall.
export fn wander(view: SelfView, observation: Observation) -> Intent {
  let heading = drift(view, observation)
  toward(inside(view.at.plus(heading.scaled(20.0)), observation), 0.35)
}

/// The same place, moved inside the reef if it was not.
///
/// A behaviour may aim anywhere; a behaviour that aims outside spends the tick
/// swimming into a wall. The margin keeps an aim off the edge rather than on
/// it, because a creature pinned to a wall is a creature that has stopped
/// being able to turn away from anything.
export fn inside(at: Point, observation: Observation) -> Point {
  let margin = 3.0
  Point(
    x: at.x.max(margin).min(observation.reef.x - margin),
    y: at.y.max(margin).min(observation.reef.y - margin),
  )
}
