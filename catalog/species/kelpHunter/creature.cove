use contract.Decision
use contract.Intent
use contract.Observation
use contract.Patch
use contract.Reason
use contract.SelfView
use contract.Sighting
use instinct.nearest
use instinct.prey
use instinct.stepOr
use instinct.towards
use instinct.wander

// The kelp hunter: hunts what it can reach, and follows what it cannot.
//
// Prey is what it is for, and the reef is what it falls back on: a hunter
// with nothing in sight is a hunter spending energy on walking, and a patrol
// it cannot pay for is how one starves. So below `patrol()` it eats what is
// underfoot if anything is, and waits if nothing is, and does not walk.

/// The one intent this hunter answers the tick with, and why.
export fn decide(view: SelfView, observation: Observation) -> Decision {
  let visible = prey(observation.nearby)
  match nearest(reachable(within(visible, 1), observation)) {
    Some(caught) => return Decision(
      intent: Intent.Hunt(caught.id),
      reason: Reason.Hunting,
    )
    None => ()
  }
  match nearest(visible) {
    Some(seen) => return Decision(
      intent: stepOr(towards(seen.at, observation), Intent.Rest),
      reason: Reason.Hunting,
    )
    None => ()
  }
  if view.energy < patrol() {
    if observation.here > 0 {
      return Decision(intent: Intent.Eat, reason: Reason.Feeding)
    }
    return Decision(intent: Intent.Rest, reason: Reason.Waiting)
  }
  Decision(intent: wander(view, observation), reason: Reason.Exploring)
}

/// The sightings no further away than `steps`.
fn within(sightings: Array<Sighting>, steps: Int) -> Array<Sighting> {
  sightings.filter(fn(sighting) {
    sighting.away <= steps
  })
}

/// The adjacent prey a hunt would actually reach.
///
/// The world refuses a hunt into cover, and a hunter that lunged at one
/// anyway would spend the tick finding that out. It can see which of the four
/// cells around it is cover, so it is the hunter that decides not to.
fn reachable(
  sightings: Array<Sighting>,
  observation: Observation,
) -> Array<Sighting> {
  sightings.filter(fn(sighting) {
    !covered(observation.around, sighting)
  })
}

/// Whether the cell this sighting stands in is cover.
fn covered(around: Array<Patch>, sighting: Sighting) -> Bool {
  for patch in around {
    if patch.at.x == sighting.at.x && patch.at.y == sighting.at.y {
      return patch.shelter
    }
  }
  false
}

/// The energy below which a hunter stops patrolling and waits.
fn patrol() -> Int {
  20
}
